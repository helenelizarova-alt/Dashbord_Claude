# Скопируйте этот файл в .env и впишите ключи. После изменения .env перезапустите сервер (npm start).
# Пустая строка = ключ не задан, канал работает на демо-данных или на загруженных отчётах.

# Wildberries: токен с категориями «Статистика», «Цены и скидки», «Календарь акций» (ЛК → Настройки → Доступ к API)
WB_TOKEN=
# Токен с категорией «Продвижение», если он отдельный. Пусто — используется WB_TOKEN
WB_ADV_TOKEN=

# Ozon Seller API (ЛК → Настройки → Seller API)
OZON_CLIENT_ID=
OZON_API_KEY=

# Ozon Performance API, реклама (performance.ozon.ru → Настройки → API)
OZON_PERF_CLIENT_ID=
OZON_PERF_SECRET=

# ИИ-ассистент (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Сервер
PORT=3000
HOST=127.0.0.1
